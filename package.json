{
  "name": "copychecker-v3",
  "version": "3.0.0",
  "description": "Simple desktop page check for spelling and unexpected English",
  "main": "dist/main/index.js",
  "author": "CopyChecker",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/build-main.js && wait-on http://localhost:5174 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.js",
    "build": "npm run build:renderer && npm run build:main",
    "test:router": "node scripts/test-router.js && node scripts/test-spelling-skip.js",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dictionary-cs": "^4.0.0",
    "dictionary-da": "^6.0.0",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-hu": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-nb": "^3.0.0",
    "dictionary-nl": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-ro": "^3.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-sv": "^4.0.0",
    "dictionary-tr": "^2.0.0",
    "dictionary-uk": "^4.0.0",
    "exceljs": "^4.4.0",
    "franc": "^6.2.0",
    "nspell": "^2.1.5",
    "playwright": "^1.49.1",
    "retext": "^9.0.0",
    "retext-english": "^5.0.0",
    "retext-passive": "^5.0.0",
    "retext-readability": "^8.0.0",
    "retext-repeated-words": "^4.1.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
